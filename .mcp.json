{
  "mcpServers": {
    "momentic": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/local-mcp.cjs", "momentic@3.75.0"],
      "env": {
        "MOMENTIC_PLUGIN_API_KEY": "${user_config.MOMENTIC_API_KEY}"
      }
    },
    "momentic-mobile": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/local-mcp.cjs", "momentic-mobile@1.48.4"],
      "env": {
        "MOMENTIC_PLUGIN_API_KEY": "${user_config.MOMENTIC_API_KEY}"
      }
    },
    "momentic-hosted": {
      "command": "npx",
      "args": ["-y", "qa", "mcp"]
    }
  }
}
